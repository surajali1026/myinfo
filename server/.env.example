PORT=8787
FRONTEND_ORIGIN=http://localhost:5173
GEMINI_API_KEY=add-your-private-key-in-host-environment
GEMINI_MODEL=gemini-2.5-flash-lite
MAX_SCRIPT_WORDS=1900

# Configure these privately in the API host's environment settings; never commit real values.
ADMIN_USERNAME=change-this-login-id
ADMIN_PASSWORD_HASH=generate-with-server/scripts/create-login-secrets.js
AUTH_SECRET=replace-with-a-long-random-secret

# Optional AI scene image generation (Pollinations; requires your own key/credits)
POLLINATIONS_API_KEY=add-your-private-pollinations-key
POLLINATIONS_IMAGE_MODEL=flux
