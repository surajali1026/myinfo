PORT=8787
FRONTEND_ORIGIN=http://localhost:5173
GEMINI_API_KEY=add-your-private-key-in-host-environment
GEMINI_MODEL=gemini-2.5-flash-lite
MAX_SCRIPT_WORDS=1900

# Configure these privately in the API host's environment settings; never commit real values.
ADMIN_USERNAME=change-this-login-id
ADMIN_PASSWORD_HASH=generate-with-server/scripts/create-login-secrets.js
AUTH_SECRET=replace-with-a-long-random-secret

# Cloudflare Workers AI image generation (Free plan allowance: 10,000 Neurons/day)
# Create a Cloudflare API token with Workers AI access and copy your Account ID.
# Do not enable a paid Workers plan or add prepaid AI Gateway credits.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-private-cloudflare-api-token
